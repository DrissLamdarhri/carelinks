# ============================================================================
# Backup credentials — COPY this file to `.env.backup` (same folder) and fill
# in the real values. `.env.backup` is gitignored and must NEVER be committed.
#
# Where to find each value — Supabase Dashboard (https://supabase.com/dashboard,
# project "nurseMorocco", ref wjhzrovmktekfcjohhrw):
#   SUPABASE_URL              Settings -> API -> Project URL
#   SUPABASE_SERVICE_ROLE_KEY Settings -> API -> service_role secret
#                              (bypasses RLS entirely — treat like root password;
#                              this is required to read the private storage
#                              buckets: pro-documents, patient-ids)
#   SUPABASE_DB_PASSWORD      Settings -> Database -> Database password
#                              (reset it there if you don't have it saved —
#                              resetting invalidates the old one, so update
#                              anywhere else it's used, e.g. a pooler client)
# ============================================================================

SUPABASE_URL=https://wjhzrovmktekfcjohhrw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=
